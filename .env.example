# Supabase — โปรเจค NKT
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# service_role key: ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น อย่าขึ้นต้นด้วย NEXT_PUBLIC_
# หาได้ที่ Supabase Dashboard → Project Settings → API → service_role
# schema v2 ปิด anon สนิท แอปจึงอ่าน/เขียนผ่าน key นี้ทางเซิร์ฟเวอร์อย่างเดียว
SUPABASE_SERVICE_ROLE_KEY=

# เปิดเส้นทางนำเข้าข้อมูลเก่าจาก Google Sheet ชั่วคราว (ใส่ค่าอะไรก็ได้ที่เดายาก)
# ใช้ครั้งเดียวตอนย้ายระบบแล้วลบบรรทัดนี้ทิ้ง — เส้นทางนี้ลบเคสทั้งหมดได้ด้วย reset=1
LEGACY_IMPORT_TOKEN=
